<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>
<VBox spacing="20.0" style="-fx-background-color: #F7F7F7" stylesheets="@style.css" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="pe.edu.upeu.proyecto_sql.controller.ClienteController">
    <padding>
        <Insets bottom="20.0" left="20.0" top="20.0"/>
    </padding>
    <children>
        <HBox alignment="BASELINE_LEFT" spacing="15.0">
            <padding>
                <Insets right="10.0"/>
            </padding>
            <children>
                <Label text="Gestion de Clientes" textFill="#014074">
                   <font>
                       <Font name="System Bold" size="20.0"/>
                   </font>
                </Label>
                <Region HBox.hgrow="ALWAYS"/>
                <Button mnemonicParsing="false" styleClass="button-login" text="+ NUEVO" onAction="#handleNew"/>
            </children>
        </HBox>
        <TableView fx:id="tableCliente">
            <columns>
                <TableColumn fx:id="ColNumero" prefWidth="30.0" text="N°"/>
                <TableColumn fx:id="ColId" prefWidth="30.0" text="10" visible="false"/>
                <TableColumn fx:id="ColNombres" prefWidth="150.0" text="Nombres"/>
                <TableColumn fx:id="ColApellidos" prefWidth="150.0" text="Apellidos"/>
                <TableColumn fx:id="ColDni" prefWidth="80.0" text="DNI"/>
                <TableColumn fx:id="ColEmail" prefWidth="180.0" text="Email"/>
                <TableColumn fx:id="ColGenero" prefWidth="80.0" text="Genero"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
        <!-- Botones -->
        <HBox alignment="CENTER_RIGHT" spacing="10.0" >
            <padding>
                <Insets right="10.0"/>
            </padding>
            <children>
                <Button mnemonicParsing="false" styleClass="button-action-edit" text="EDITAR" onAction="#handleEdit"/>
                <Button mnemonicParsing="false" styleClass="button-action-delete" text="ELIMINAR" onAction="#handleDelete"/>
            </children>
        </HBox>
    </children>
</VBox>
