<?xml version="1.0" ?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" spacing="10.0" style="-fx-background-color: white" stylesheets="@style.css" fx:controller="pe.edu.upeu.proyecto_sql.controller.HabitacionFormController">
    <padding>
        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0"/>
    </padding>
    <Label text="Datos de la habitacion" textFill="#014074">
        <font>
            <Font name="System Bold" size="16.0"/>
        </font>
    </Label>
    <Separator/>
    <GridPane hgap="10.0" vgap="10.0">
        <columnConstraints>
            <ColumnConstraints prefWidth="120.0"/>
            <ColumnConstraints prefWidth="220.0"/>
        </columnConstraints>
        <children>
            <Label text="Numero *" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="txtNumero" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            <Label text="Numero de piso" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="txtNumeroPiso" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            <Label text="N° habitacion" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="txtNumeroHabitacion" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            <Label text="Tipo *" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <TextField fx:id="txtTipo" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            <Label text="Precio *" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <TextField fx:id="txtPrecio" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
            <Label text="Estado" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
            <ComboBox fx:id="cbxEstado" maxWidth="Infinity" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
        </children>
    </GridPane>
    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <padding>
            <Insets top="10.0"/>
        </padding>
        <Button fx:id="btnCancelar" text="Cancelar" styleClass="button-action-delete" onAction="#handleCancel" cancelButton="true"/>
        <Button fx:id="btnGuardar" text="Guardar" styleClass="button-action-edit" onAction="#handleSave" defaultButton="true"/>
    </HBox>
</VBox>
